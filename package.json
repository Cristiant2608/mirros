{
  "name": "mirros",
  "version": "2.0.0",
  "description": "Pantalla, audio y control de iPhone por USB en Windows y Linux",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "pack:windows": "electron-builder --win portable --x64",
    "build": "vite build --config frontend/vite.config.mjs",
    "pack:linux": "electron-builder --linux AppImage --x64 --config.directories.output=../Mirros-Linux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cristiant2608/mirros.git"
  },
  "keywords": [],
  "author": "Cristian Torres",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Cristiant2608/mirros/issues"
  },
  "homepage": "https://github.com/Cristiant2608/mirros#readme",
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
